    "@types/node": "^20.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^5.14.0",
