# Database
# DATABASE_URL="postgresql://user:password@localhost:5432/agrotrack?schema=public"
DATABASE_URL="jdbc:postgresql://localhost:5432/agro_track"
jdbc:postgresql://localhost:5432/agro_db
jdbc:postgresql://localhost:5432/finance_db

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Redis
# REDIS_ENABLED="true" enables Redis-backed caching, rate limiting, the
# background job queues (email/SMS/push/webhook/report), and the Socket.IO
# Redis adapter used for cross-instance realtime delivery.
# REDIS_ENABLED="false" uses an in-memory fallback and skips background jobs.
#
# IMPORTANT: multi-instance deployments (2+ API processes behind a load
# balancer) REQUIRE REDIS_ENABLED="true". With it off, each instance keeps its
# Socket.IO rooms in local memory, so a message sent through instance A never
# reaches a client connected to instance B — realtime silently breaks.
# Single-instance / local dev can leave this "false".
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379"

# Message retention (chat). 0 = keep messages forever (default). Set to a
# positive number of days to enable a daily background sweep that PERMANENTLY
# deletes messages older than the window. Requires REDIS_ENABLED="true" (the
# sweep runs as a Bull job). Deletion is irreversible — opt in deliberately.
MESSAGE_RETENTION_DAYS="0"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Email (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@agrotrack.ng"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Paystack
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Cloudinary (document/photo uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Termii (SMS)
TERMII_API_KEY=""

# SendGrid (email)
SENDGRID_API_KEY=""

# Platform bank details (shown to borrowers for the manual bank-transfer repayment channel)
PLATFORM_BANK_NAME="AgroTrack Microfinance Bank"
PLATFORM_BANK_ACCOUNT="0123456789"
PLATFORM_BANK_ACCOUNT_NAME="AgroTrack Ltd"
