# Database
# DATABASE_URL="postgresql://user:password@localhost:5432/agrotrack?schema=public"
DATABASE_URL="jdbc:postgresql://localhost:5432/agro_track"
jdbc:postgresql://localhost:5432/agro_db
jdbc:postgresql://localhost:5432/finance_db

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Redis (optional)
# REDIS_ENABLED="true" enables Redis-backed caching, rate limiting and the
# background job queues (email/SMS/push/webhook/report).
# REDIS_ENABLED="false" uses an in-memory fallback and skips background jobs.
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Email (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@agrotrack.ng"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Paystack
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# AWS S3 (document/photo uploads)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
AWS_S3_BUCKET=""

# Termii (SMS)
TERMII_API_KEY=""

# SendGrid (email)
SENDGRID_API_KEY=""

# Platform bank details (shown to borrowers for the manual bank-transfer repayment channel)
PLATFORM_BANK_NAME="AgroTrack Microfinance Bank"
PLATFORM_BANK_ACCOUNT="0123456789"
PLATFORM_BANK_ACCOUNT_NAME="AgroTrack Ltd"
